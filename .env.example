# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-a-strong-random-string
JWT_SECRET_KEY=your-jwt-secret-key-here-different-from-secret-key

# Database Configuration
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_NAME=bread_wise_db

# For production, use DATABASE_URL instead (provided by hosting service)
# DATABASE_URL=mysql+pymysql://user:password@host/dbname

# CORS Configuration (optional - add your frontend domain)
# CORS_ORIGINS=https://yourdomain.com
